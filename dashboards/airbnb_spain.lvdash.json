{
  "datasets": [
    {
      "name": "city_metrics",
      "displayName": "city_metrics",
      "queryLines": [
        "SELECT city, listings, listings_with_price, median_price, median_price_entire_home, median_price_private_room,\n",
        "       avg_availability_365, avg_review_score, hosts, share_multi_listing_hosts, share_without_price,\n",
        "       share_registered_license\n",
        "FROM workspace.airbnb_gold.city_metrics\n"
      ]
    },
    {
      "name": "room_mix",
      "displayName": "room_mix",
      "queryLines": [
        "SELECT city, room_type, share\n",
        "FROM workspace.airbnb_gold.city_metrics\n",
        "LATERAL VIEW stack(4, 'Entire home/apt', share_entire_home, 'Private room', share_private_room,\n",
        "                      'Shared room', share_shared_room, 'Hotel room', share_hotel_room) s AS room_type, share\n"
      ]
    },
    {
      "name": "neighbourhoods",
      "displayName": "neighbourhoods",
      "queryLines": [
        "SELECT city, neighbourhood, neighbourhood_group, listings, listings_with_price, median_price, avg_review_score\n",
        "FROM workspace.airbnb_gold.neighbourhood_metrics\n",
        "WHERE listings_with_price >= 20\n"
      ]
    },
    {
      "name": "top_neighbourhoods",
      "displayName": "top_neighbourhoods",
      "queryLines": [
        "SELECT city, neighbourhood, median_price, listings\n",
        "FROM (\n",
        "  SELECT city, neighbourhood, median_price, listings,\n",
        "         ROW_NUMBER() OVER (PARTITION BY city ORDER BY median_price DESC) AS rn\n",
        "  FROM workspace.airbnb_gold.neighbourhood_metrics\n",
        "  WHERE listings_with_price >= 20\n",
        ") WHERE rn <= 10\n"
      ]
    },
    {
      "name": "underpriced_neighbourhoods",
      "displayName": "underpriced_neighbourhoods",
      "queryLines": [
        "SELECT city, neighbourhood, COUNT(*) AS test_listings, AVG(error) AS avg_error\n",
        "FROM workspace.airbnb_gold.predictions\n",
        "WHERE split = 'test' AND outlier_class = 'ok'\n",
        "GROUP BY city, neighbourhood\n",
        "HAVING COUNT(*) >= 15\n",
        "ORDER BY avg_error ASC\n",
        "LIMIT 12\n"
      ]
    },
    {
      "name": "listings_ok",
      "displayName": "listings_ok",
      "queryLines": [
        "SELECT city, room_type, accommodates, price,\n",
        "       CASE WHEN minimum_nights >= 30 THEN '30+ nights (mid-term)' ELSE 'under 30 nights' END AS stay_type,\n",
        "       availability_365, review_scores_rating\n",
        "FROM workspace.airbnb_silver.listings\n",
        "WHERE outlier_class = 'ok'\n"
      ]
    },
    {
      "name": "model_vs_baseline",
      "displayName": "model_vs_baseline",
      "queryLines": [
        "SELECT city, predictor, mae\n",
        "FROM workspace.airbnb_gold.model_metrics\n",
        "LATERAL VIEW stack(2, 'model', mae_model, 'baseline (room type x guests)', mae_baseline) s AS predictor, mae\n",
        "WHERE population = 'ok'\n"
      ]
    },
    {
      "name": "test_predictions",
      "displayName": "test_predictions",
      "queryLines": [
        "SELECT city, id, neighbourhood, room_type, accommodates, price, predicted_price, baseline_price, error, abs_error\n",
        "FROM workspace.airbnb_gold.predictions\n",
        "WHERE split = 'test' AND outlier_class = 'ok'\n"
      ]
    },
    {
      "name": "worst_predictions",
      "displayName": "worst_predictions",
      "queryLines": [
        "SELECT city, id, neighbourhood, room_type, accommodates,\n",
        "       ROUND(price, 0) AS price, ROUND(predicted_price, 0) AS predicted, ROUND(error, 0) AS error,\n",
        "       CASE WHEN error < 0 THEN 'under-priced' ELSE 'over-priced' END AS direction\n",
        "FROM workspace.airbnb_gold.predictions\n",
        "WHERE split = 'test' AND outlier_class = 'ok'\n",
        "ORDER BY abs_error DESC\n",
        "LIMIT 30\n"
      ]
    },
    {
      "name": "city_c_runs",
      "displayName": "city_c_runs",
      "queryLines": [
        "SELECT * FROM VALUES\n",
        "  ('1. first run (v1, unchanged)', 'baseline (Madrid + Sevilla medians)', 85.02),\n",
        "  ('1. first run (v1, unchanged)', 'model', 80.65),\n",
        "  ('2. after retrain with Barcelona (v2)', 'baseline (Barcelona own medians)', 81.16),\n",
        "  ('2. after retrain with Barcelona (v2)', 'model', 47.85)\n",
        "  AS t(stage, predictor, mae)\n"
      ]
    }
  ],
